{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#e1a65634da8cdfd89662af277f258134dfa6cc8c", // main
    "github>tbhb-dev/renovate-config//bazel.json5#e1a65634da8cdfd89662af277f258134dfa6cc8c", // main
  ],

  // evals: one Bazel module, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
